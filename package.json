{
  "name": "first-screen-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "npm run build && wrangler dev",
    "setup:local": "node scripts/local-setup.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run check && npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run --outdir dist/dry-run",
    "recover": "node scripts/recover.mjs"
  },
  "dependencies": {
    "fast-png": "7.0.1",
    "jpeg-js": "0.4.4"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "wrangler": "4.50.0"
  }
}
